{
  "name": "prime-agent-dsh",
  "version": "0.0.4",
  "description": "DeepSeek Harness inference-context integration and explicit DSH delegation for Prime Agent.",
  "keywords": [
    "pi-package",
    "prime-agent-package",
    "prime-agent",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "type": "module",
  "license": "MIT",
  "files": [
    "extensions",
    "src",
    "skills",
    "dsh/acp-route.patch.yml",
    "dsh/cordis.patch.yml",
    "dsh/package.json",
    "dsh/provider.js",
    "dsh/tool.js",
    "dsh/README.md",
    "README.md",
    "LICENSE",
    "docs",
    "context-service/package.json",
    "context-service/package-lock.json",
    "context-service/README.md",
    "context-service/tsconfig.json",
    "context-service/src",
    "context-service/test"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint \"src/**/*.ts\" \"extensions/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.1",
    "tsx": "^4.20.0",
    "typebox": "1.3.25",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
