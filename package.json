    "pi-package",
    "prime-agent-package",
    "prime-agent",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "type": "module",
  "license": "MIT",
  "files": [
    "extensions",
    "src",
    "skills",
    "dsh/acp-route.patch.yml",
    "dsh/cordis.patch.yml",
    "dsh/package.json",
    "dsh/provider.js",
    "dsh/tool.js",
    "dsh/README.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
